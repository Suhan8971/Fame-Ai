# Copy this file to .env and fill in your real values (never commit .env).

# --- Virtual try-on --------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
#
# When set, the app tries OpenAI's gpt-image-2 for virtual try-on first
# (cloud-based, ~$0.03-0.08 per try-on depending on resolution/quality --
# sends the model's photo and the garment photo to OpenAI's API). Without a
# key, the app works exactly as before (CatVTON if a CUDA GPU is available,
# else the fast local geometric fallback) -- nothing else changes.
OPENAI_API_KEY=

# --- Server ------------------------------------------------------------------
# Port the API listens on. Must match VITE_SCANNER_API_URL in frontend/.env.
SCANNER_PORT=5050
# Webcam used for the Models section's capture (0 = default camera).
CAMERA_INDEX=0
# Browser origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
