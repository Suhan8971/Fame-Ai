# Copy this file to .env and fill in your real values (never commit .env).

# --- Virtual try-on --------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
#
# When set, the app tries OpenAI's gpt-image-2 for virtual try-on first
# (cloud-based, ~$0.03-0.08 per try-on depending on resolution/quality --
# sends the model's photo and the garment photo to OpenAI's API). Without a
# key, the app works exactly as before (CatVTON if a CUDA GPU is available,
# else the fast local geometric fallback) -- nothing else changes.
OPENAI_API_KEY=

# --- Server ------------------------------------------------------------------
# Port the API listens on locally. In production most hosts (Render
# included) set PORT for you and this is only the fallback -- see the
# README/deploy notes for why PORT is checked first in app.py.
SCANNER_PORT=5050
# "browser" (default): the scanner's camera is the CANDIDATE'S OWN browser
# (getUserMedia -> POST /push_frame) -- required for any deployment where
# this backend has no physical camera attached, e.g. Render. "local": the
# original behaviour, this process opens CAMERA_INDEX itself with OpenCV --
# only useful if you're running the backend on the same machine you're
# scanning from and want the server, not the browser, to own the camera.
CAMERA_MODE=browser
# Only read when CAMERA_MODE=local. Webcam index for the Models section's
# capture (0 = default camera).
CAMERA_INDEX=0
# Browser origins allowed to call this API (comma separated). Add your
# deployed Vercel domain here in production, e.g.
# CORS_ORIGINS=http://localhost:5173,https://your-project.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
